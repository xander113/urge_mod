# ============================================================
# URGE v3 – Map-Screen GUI
# Flattened containers for Scripted GUI visibility toggling
# ============================================================

guiTypes = {

	# ── Toggle Button (Always visible) ───────────────────────────────────────
	containerWindowType = {
		name        = "URGE_toggle_window"
		position    = { x = -52  y = -24 }
		orientation = CENTER_RIGHT
		
		buttonType = {
			name              = "URGE_toggle_btn"
			position          = { x = 0  y = 0 }
			quadTextureSprite = "GFX_decision_cat_URGE"
			shortcut          = "b"
			pdx_tooltip       = "URGE_TOGGLE_TT"
			clicksound        = click_close
		}
	}

	# ── Panel Background & Text (Visible when Open) ──────────────────────────
	containerWindowType = {
		name        = "URGE_panel_bg_window"
		position    = { x = -360  y = -195 }
		size        = { width = 304  height = 390 }
		orientation = CENTER_RIGHT

		iconType = {
			name       = "URGE_bg_icon"
			spriteType = "GFX_URGE_panel_bg"
			position   = { x = 0  y = 0 }
		}

		instantTextboxType = {
			name      = "URGE_header_txt"
			position  = { x = 8  y = 7 }
			maxWidth  = 288
			maxHeight = 24
			font      = "hoi_20b"
			text      = "URGE_PANEL_HEADER"
			format    = center
		}

		instantTextboxType = {
			name              = "URGE_footer_txt"
			position          = { x = 4  y = 358 }
			maxWidth          = 296
			maxHeight         = 24
			font              = "hoi_13"
			text              = "URGE_PANEL_FOOTER"
			format            = center
			alwaystransparent = yes
		}
	}

	# ── Row 1: Activate Supremacy (Supremacy OFF) ────────────────────────────
	containerWindowType = {
		name        = "URGE_supremacy_off_window"
		position    = { x = -358  y = -155 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_sup_off_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_purple"
			buttonText  = "URGE_BTN_ACTIVATE"
			font        = "hoi_18mbs"
			shortcut    = "b"
			pdx_tooltip = "URGE_BTN_ACTIVATE_TT"
			clicksound  = decisions_ui_confirm
		}
	}

	# ── Row 1: Deactivate Supremacy (Supremacy ON) ───────────────────────────
	containerWindowType = {
		name        = "URGE_supremacy_on_window"
		position    = { x = -358  y = -155 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_sup_on_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_red"
			buttonText  = "URGE_BTN_DEACTIVATE"
			font        = "hoi_18mbs"
			shortcut    = "b"
			pdx_tooltip = "URGE_BTN_DEACTIVATE_TT"
			clicksound  = decisions_ui_decline
		}
	}

	# ── Row 2: Grand Military ────────────────────────────────────────────────
	containerWindowType = {
		name        = "URGE_military_window"
		position    = { x = -358  y = -115 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_military_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_blue"
			buttonText  = "URGE_BTN_MILITARY"
			font        = "hoi_18mbs"
			pdx_tooltip = "URGE_BTN_MILITARY_TT"
			clicksound  = decisions_ui_confirm
		}
	}

	# ── Row 3: Commission Bureau (No Agency) ─────────────────────────────────
	containerWindowType = {
		name        = "URGE_commission_window"
		position    = { x = -358  y = -75 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_commission_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_violet"
			buttonText  = "URGE_BTN_COMMISSION"
			font        = "hoi_18mbs"
			pdx_tooltip = "URGE_BTN_COMMISSION_TT"
			clicksound  = decisions_ui_confirm
		}
	}

	# ── Row 3: Maximize Agency (Has Agency) ──────────────────────────────────
	containerWindowType = {
		name        = "URGE_max_agency_window"
		position    = { x = -358  y = -75 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_max_agency_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_violet"
			buttonText  = "URGE_BTN_MAX_AGENCY"
			font        = "hoi_18mbs"
			pdx_tooltip = "URGE_BTN_MAX_AGENCY_TT"
			clicksound  = decisions_ui_confirm
		}
	}

	# ── Row 4: Emergency Resupply ────────────────────────────────────────────
	containerWindowType = {
		name        = "URGE_resupply_window"
		position    = { x = -358  y = -35 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_resupply_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_green"
			buttonText  = "URGE_BTN_RESUPPLY"
			font        = "hoi_18mbs"
			pdx_tooltip = "URGE_BTN_RESUPPLY_TT"
			clicksound  = decisions_ui_confirm
		}
	}

	# ── Row 5: Commandeer Resources ──────────────────────────────────────────
	containerWindowType = {
		name        = "URGE_resources_window"
		position    = { x = -358  y = 5 }
		orientation = CENTER_RIGHT

		buttonType = {
			name        = "URGE_resources_btn"
			position    = { x = 0  y = 0 }
			spriteType  = "GFX_URGE_btn_green"
			buttonText  = "URGE_BTN_RESOURCES"
			font        = "hoi_18mbs"
			pdx_tooltip = "URGE_BTN_RESOURCES_TT"
			clicksound  = decisions_ui_confirm
		}
	}
}